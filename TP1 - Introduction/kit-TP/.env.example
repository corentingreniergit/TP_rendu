# Copier en .env puis changer les mots de passe (alphanumériques, >= 6 caractères)
STACK_VERSION=9.5.4
ELASTIC_PASSWORD=ChangeMoi2026
KIBANA_PASSWORD=ChangeMoiAussi2026
# 32 caractères minimum (générer avec : python -c "import secrets; print(secrets.token_hex(16))")
KIBANA_ENCRYPTION_KEY=remplacer_par_32_caracteres_aleatoires
ES_MEM_LIMIT=2g
KB_MEM_LIMIT=1g
