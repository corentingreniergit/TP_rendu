# Fins de ligne : LF partout, dans le dépôt ET dans la copie de travail.
#
# Ce fichier a priorité sur la configuration locale `core.autocrlf`, y compris
# sur le `core.autocrlf=true` que Git for Windows installe par défaut : le TP se
# comporte de la même façon sous Windows, macOS et Linux.

* text=auto eol=lf

*.py            text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.ndjson        text eol=lf
*.sh            text eol=lf
.env*           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
